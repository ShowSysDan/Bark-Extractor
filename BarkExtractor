@app.route("/api/settings", methods=["GET"])
def api_get_settings():
    return jsonify({
        "syslog_enabled": SYSLOG_ENABLED,
        "syslog_host":    SYSLOG_HOST,
        "syslog_port":    SYSLOG_PORT,
    })


@app.route("/api/settings", methods=["POST"])
def api_save_settings():
    global SYSLOG_ENABLED, SYSLOG_HOST, SYSLOG_PORT

    data = request.get_json(silent=True) or {}

    enabled = bool(data.get("syslog_enabled", False))
    host    = str(data.get("syslog_host", "localhost")).strip()
    port_raw = data.get("syslog_port", 514)
    try:
        port = int(port_raw)
        if not (1 <= port <= 65535):
            raise ValueError
    except (ValueError, TypeError):
        return jsonify({"error": "Port must be an integer between 1 and 65535"}), 400
    if not host:
        return jsonify({"error": "Host is required"}), 400

    try:
        _update_env_file({
            "SYSLOG_ENABLED": "true" if enabled else "false",
            "SYSLOG_HOST":    host,
            "SYSLOG_PORT":    str(port),
        })
    except Exception as exc:
        app.logger.warning("Could not write .env file: %s", exc)
        # Non-fatal – settings are still applied in memory for this session

    SYSLOG_ENABLED = enabled
    SYSLOG_HOST    = host
    SYSLOG_PORT    = port
    syslog_sender.configure(SYSLOG_ENABLED, SYSLOG_HOST, SYSLOG_PORT)

    syslog_sender.send(
        f"settings_saved syslog_enabled={enabled} "
        f"syslog_host={host} syslog_port={port}"
    )

    return jsonify({"ok": True})


@app.route("/api/settings/test", methods=["POST"])
