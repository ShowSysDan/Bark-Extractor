# ---------------------------------------------------------------------------

@app.route("/api/download/<download_id>/stream")
def api_download_stream(download_id):
    """Server-Sent Events stream for a specific download."""
    q: queue.Queue = queue.Queue(maxsize=200)

    with _sse_lock:
        if download_id not in _sse_subscribers:
            _sse_subscribers[download_id] = []
        _sse_subscribers[download_id].append(q)

    @stream_with_context
    def generate():
        try:
            # Send a heartbeat immediately so the browser connection opens
            yield f"data: {json.dumps({'type': 'heartbeat'})}\n\n"
            # A job that failed fast (or a page reload after it finished)
            # can complete before this stream subscribes; its final event
            # was broadcast to nobody, so report the outcome directly.
            job = download_manager.get_job(download_id)
            if job is None:
                yield f"data: {json.dumps({'type': 'error', 'message': 'Job not found'})}\n\n"
                yield f"data: {json.dumps({'type': 'close'})}\n\n"
                return
            if job.is_finished:
                yield f"data: {json.dumps(_done_event(job))}\n\n"
                yield f"data: {json.dumps({'type': 'close'})}\n\n"
                return
            while True:
                try:
                    msg = q.get(timeout=30)
                except queue.Empty:
                    # Keep-alive ping
                    yield ": ping\n\n"
                    continue
                yield msg
                if '"type": "close"' in msg:
                    break
        finally:
            with _sse_lock:
                subs = _sse_subscribers.get(download_id)
                if subs is not None:
                    if q in subs:
                        subs.remove(q)
                    if not subs:
                        # Last subscriber gone – drop the registry entry so
                        # abandoned download ids don't accumulate forever.
                        _sse_subscribers.pop(download_id, None)

    return Response(
        generate(),
        mimetype="text/event-stream",
        headers={
            "Cache-Control": "no-cache",
            "X-Accel-Buffering": "no",
        },
    )


