def _resolve_file_or_abort(file_id: str) -> str:
    """Map a library file id to its absolute path, or abort with 404/403."""
    path = file_manager.get_file_path(file_id)
    if not path:
        abort(404)
    # Path traversal guard: the file must live inside downloads_dir
    real, root = os.path.realpath(path), os.path.realpath(DOWNLOADS_DIR)
    if os.path.commonpath([real, root]) != root:
        abort(403)
    return path


def _send_audio(path: str, **kwargs):
    ext = os.path.splitext(path)[1].lower()
    return send_file(path, mimetype=_AUDIO_MIME.get(ext, "audio/mpeg"), **kwargs)


def _start_normalize(path: str):
    """Start (or join) a normalize job for path. Returns (job, created)."""
    job, created = download_manager.create_normalize_job(path, get_session_id())
    if created:
        syslog_sender.send(
            f"normalize_started id={job.download_id} file={os.path.basename(path)}")
        _start_poller(job.download_id)
    return job, created


@app.route("/api/files/<file_id>/normalize", methods=["POST"])
def api_normalize_file(file_id):
    """
    Produce the peak-normalized copy of a library file as a background job.
    Returns {"ready": true, "file_id", "name"} when an up-to-date copy already
    exists, otherwise {"download_id"} of the job (stream it like a download).
    """
    path = _resolve_file_or_abort(file_id)
    if normalizer.is_normalized_name(path):
        return jsonify({"error": "This file is already a normalized copy."}), 400

    if normalizer.normalized_is_current(path):
        norm_rel = os.path.relpath(normalizer.normalized_path_for(path), DOWNLOADS_DIR)
        return jsonify({
            "ready": True,
            "file_id": FileManager.file_id(norm_rel),
            "name": os.path.basename(norm_rel),
        })

    job, _ = _start_normalize(path)
    return jsonify({"download_id": job.download_id, "status": job.status})


@app.route("/api/files/<file_id>/download")
def api_download_file(file_id):
    """Serve an audio file to the user's browser as an attachment."""
    path = _resolve_file_or_abort(file_id)

    # Legacy synchronous form of POST /normalize: blocks until the copy is ready.
    if request.args.get("normalize") == "1" and not normalizer.is_normalized_name(path):
        if not normalizer.normalized_is_current(path):
            job, _ = _start_normalize(path)
            if not job.wait(timeout=600) or job.status != JobStatus.COMPLETED:
                app.logger.error("Normalization failed: %s", job.error or "timed out")
                abort(500, description="Audio normalization failed.")
        path = normalizer.normalized_path_for(path)

    suffix = " normalized=true" if normalizer.is_normalized_name(path) else ""
    syslog_sender.send(f"file_downloaded file={os.path.basename(path)}{suffix}")
    return _send_audio(path, as_attachment=True)


@app.route("/api/files/<file_id>/stream")
def api_stream_file(file_id):
    """Serve audio inline for in-browser playback with range-request support for seeking."""
    path = _resolve_file_or_abort(file_id)
    return _send_audio(path, conditional=True)


@app.route("/api/files/<file_id>", methods=["DELETE"])
def api_delete_file(file_id):
    # Resolve name before deletion for the syslog message
    path = file_manager.get_file_path(file_id)
    fname = os.path.basename(path) if path else file_id
    if file_manager.delete_file(file_id):
        syslog_sender.send(f"file_deleted file={fname}")
        return jsonify({"ok": True})
    return jsonify({"ok": False, "error": "File not found"}), 404


# ---------------------------------------------------------------------------
# Background maintenance
# ---------------------------------------------------------------------------

def _job_janitor():
    """Periodically drop finished jobs from memory (they are kept for an hour
    so late page loads can still read their status, then released)."""
    while True:
        time.sleep(900)
        try:
            download_manager.cleanup_finished_jobs(max_age_seconds=3600)
        except Exception as exc:
            app.logger.warning("Job janitor error: %s", exc)


def _tools_log(msg: str):
    print(f"  [tools] {msg}", flush=True)
    syslog_sender.send(f"tools {msg}")


# Settings appended to .env on startup when absent, so they are discoverable
# and editable on the server without consulting .env.example. Existing keys,
# values, and comments are never modified.
_ENV_SEED_HEADER = "# yt-dlp auto-update settings (appended by the app; see .env.example for details)"
_ENV_SEED_DEFAULTS = {
    "YTDLP_AUTO_UPDATE": "true",
    "YTDLP_UPDATE_INTERVAL_DAYS": "3",
    "YTDLP_UPDATE_HOUR": "3",
    "YTDLP_UPDATE_CHANNEL": "nightly",
}


def _seed_env_defaults():
    env_path = BASE_DIR / ".env"
    try:
        lines = env_path.read_text().splitlines() if env_path.exists() else []
        existing = {
            line.strip().split("=", 1)[0].strip()
            for line in lines
            if line.strip() and not line.strip().startswith("#") and "=" in line
        }
        missing = [k for k in _ENV_SEED_DEFAULTS if k not in existing]
        if not missing:
            return
        block = [""] if lines else []
        if _ENV_SEED_HEADER not in lines:
            block.append(_ENV_SEED_HEADER)
        block += [f"{k}={_ENV_SEED_DEFAULTS[k]}" for k in missing]
        env_path.write_text("\n".join(lines + block) + "\n")
        print(f"  [tools] Added missing settings to .env: {', '.join(missing)}", flush=True)
    except OSError as exc:
        app.logger.warning("Could not seed .env defaults: %s", exc)


def _startup():
    """Check and prepare all runtime dependencies. Called on every start, so
    a plain `git pull && systemctl restart bark-extractor` picks everything up."""
    os.makedirs(DOWNLOADS_DIR, exist_ok=True)
    os.makedirs(SESSIONS_DIR, exist_ok=True)

    # FFmpeg presence check (warn only – the UI still serves the library)
    import shutil as _shutil
    if not (_shutil.which(FFMPEG_PATH) or os.path.isfile(FFMPEG_PATH)):
        print(f"  [tools] WARNING: ffmpeg not found at {FFMPEG_PATH!r} – "
              "audio extraction will fail until it is installed", flush=True)

    # Make the auto-update settings visible/editable in .env
    _seed_env_defaults()

    # yt-dlp + Deno: download when missing, keep yt-dlp updated overnight
    tool_manager.bootstrap(YTDLP_PATH, start_updater=True, log=_tools_log)

    threading.Thread(target=_job_janitor, daemon=True, name="job-janitor").start()


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    debug = os.getenv("FLASK_DEBUG", "false").lower() == "true"
    # Under the Flask debug reloader the script runs twice; only start the
    # background threads in the serving process.
    if not debug or os.environ.get("WERKZEUG_RUN_MAIN") == "true":
        _startup()
    print(f"  Bark Extractor v{APP_VERSION} starting on http://0.0.0.0:{PORT}")
    print(f"  Downloads directory: {DOWNLOADS_DIR}")
    app.run(host="0.0.0.0", port=PORT, debug=debug)
