def _safe_file_path(file_id: str) -> str | None:
    """Map a library file id to its absolute path, or None if the id is
    unknown or (via a symlink) resolves outside downloads_dir."""
    path = file_manager.get_file_path(file_id)
    if not path:
        return None
    # Path traversal guard: the file must live inside downloads_dir, even
    # after following any symlink.
    real, root = os.path.realpath(path), os.path.realpath(DOWNLOADS_DIR)
    try:
        if os.path.commonpath([real, root]) != root:
            return None
    except ValueError:
        # Different drives / no common path (Windows): treat as outside.
        return None
    return path


def _resolve_file_or_abort(file_id: str) -> str:
    """Map a library file id to its absolute path, or abort with 404/403."""
    path = file_manager.get_file_path(file_id)
    if not path:
        abort(404)
    if _safe_file_path(file_id) is None:
        abort(403)
    return path


def _send_audio(path: str, **kwargs):
    ext = os.path.splitext(path)[1].lower()
    return send_file(path, mimetype=_AUDIO_MIME.get(ext, "audio/mpeg"), **kwargs)


def _start_process_poller(job, detail: str):
    syslog_sender.send(f"{job.kind}_started id={job.download_id} file={job.title} {detail}".rstrip())
    _start_poller(job.download_id)
    return jsonify({"download_id": job.download_id, "status": job.status,
                    "kind": job.kind, "label": job.label, "title": job.title})


def _start_normalize(path: str):
    """Start (or join) a normalize job for path. Returns (job, created)."""
    job, created = download_manager.create_normalize_job(path, get_session_id())
    if created:
        syslog_sender.send(
            f"normalize_started id={job.download_id} file={os.path.basename(path)}")
        _start_poller(job.download_id)
    return job, created


@app.route("/api/files/<file_id>/normalize", methods=["POST"])
def api_normalize_file(file_id):
    """
    Produce the peak-normalized copy of a library file as a background job.
    Returns {"ready": true, "file_id", "name"} when an up-to-date copy already
    exists, otherwise {"download_id"} of the job (stream it like a download).
    """
    path = _resolve_file_or_abort(file_id)
    if audio_ops.is_normalized_name(path):
        return jsonify({"error": "This file is already a normalized copy."}), 400

    if audio_ops.normalized_is_current(path):
        norm_rel = os.path.relpath(audio_ops.normalized_path_for(path), DOWNLOADS_DIR)
        return jsonify({
            "ready": True,
            "file_id": FileManager.file_id(norm_rel),
            "name": os.path.basename(norm_rel),
        })

    job, _ = _start_normalize(path)
    return jsonify({"download_id": job.download_id, "status": job.status})


@app.route("/api/files/<file_id>/download")
def api_download_file(file_id):
    """Serve an audio file to the user's browser as an attachment."""
    path = _resolve_file_or_abort(file_id)

    # Legacy synchronous form of POST /normalize: blocks until the copy is ready.
    if request.args.get("normalize") == "1" and not audio_ops.is_normalized_name(path):
        if not audio_ops.normalized_is_current(path):
            job, _ = _start_normalize(path)
            if not job.wait(timeout=600) or job.status != JobStatus.COMPLETED:
                app.logger.error("Normalization failed: %s", job.error or "timed out")
                abort(500, description="Audio normalization failed.")
        path = audio_ops.normalized_path_for(path)

    suffix = " normalized=true" if audio_ops.is_normalized_name(path) else ""
    syslog_sender.send(f"file_downloaded file={os.path.basename(path)}{suffix}")
    return _send_audio(path, as_attachment=True)


@app.route("/api/files/<file_id>/trim", methods=["POST"])
def api_trim_file(file_id):
    """
    Save [start, end] seconds of a file (optional fade_in / fade_out seconds,
    optional output name) as a new file, as a background job.
    """
    path = _resolve_file_or_abort(file_id)
    data = request.get_json(silent=True) or {}
    try:
        start = float(data.get("start", 0))
        end = float(data.get("end"))
        fade_in = float(data.get("fade_in") or 0)
        fade_out = float(data.get("fade_out") or 0)
    except (TypeError, ValueError):
        return jsonify({"error": "start, end and fades must be numbers (seconds)"}), 400

    duration, _ = audio_ops.probe(FFMPEG_PATH, path)
    if duration:
        end = min(end, duration)
    if start < 0 or end - start < 0.1:
        return jsonify({"error": "Selection must be at least 0.1 s long"}), 400
    if fade_in < 0 or fade_out < 0 or fade_in + fade_out > end - start:
        return jsonify({"error": "Fades must be positive and fit inside the selection"}), 400

    try:
        job = download_manager.create_trim_job(
            path, get_session_id(), start, end, fade_in, fade_out,
            name=(data.get("name") or "").strip() or None)
    except ValueError as e:
        return jsonify({"error": str(e)}), 400
    return _start_process_poller(job, f"start={start:.2f} end={end:.2f}")


@app.route("/api/files/<file_id>/convert", methods=["POST"])
def api_convert_file(file_id):
    """Convert a file to another format (saved as a new file) as a background job."""
    path = _resolve_file_or_abort(file_id)
    data = request.get_json(silent=True) or {}
    target = "." + str(data.get("format", "")).lower().lstrip(".")
    try:
        job = download_manager.create_convert_job(path, get_session_id(), target)
    except ValueError as e:
        return jsonify({"error": str(e)}), 400
    return _start_process_poller(job, f"format={target.lstrip('.')}")


@app.route("/api/files/<file_id>/rename", methods=["POST"])
def api_rename_file(file_id):
    path = _resolve_file_or_abort(file_id)
    if download_manager.is_busy(path):
        return jsonify({"error": "File is being processed – try again when the job finishes"}), 409
    name = str((request.get_json(silent=True) or {}).get("name", ""))
    try:
        info = file_manager.rename_file(file_id, name)
    except LookupError:
        abort(404)
    except ValueError as e:
        return jsonify({"error": str(e)}), 400
    except FileExistsError:
        return jsonify({"error": "A file with that name already exists"}), 409
    except OSError as e:
        return jsonify({"error": f"Rename failed: {e.strerror}"}), 500
    syslog_sender.send(f"file_renamed from={os.path.basename(path)} to={info['name']}")
    return jsonify(info)


