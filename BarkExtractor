class _ZipStream:
    """Write-only sink for zipfile that hands written bytes to a generator."""

    def __init__(self):
        self._chunks = []

    def write(self, data):
        self._chunks.append(bytes(data))
        return len(data)

    def flush(self):
        pass

    def take(self) -> bytes:
        data, self._chunks = b"".join(self._chunks), []
        return data


@app.route("/api/files/zip")
def api_zip_files():
    """Stream the selected files (?ids=a,b,c) as one ZIP, keeping folders."""
    ids = [i for i in request.args.get("ids", "").split(",") if i]
    if not ids or len(ids) > 1000:
        return jsonify({"error": "Select between 1 and 1000 files"}), 400
    index = {f["id"]: f for f in file_manager.list_files()}
    # Resolve each id through the same traversal/symlink guard the other
    # file routes use, so the ZIP can never read outside downloads_dir.
    entries = []
    for i in dict.fromkeys(ids):
        if i not in index or _safe_file_path(i) is None:
            continue
        entries.append(index[i]["path"])
    if not entries:
        abort(404)

    def generate():
        sink = _ZipStream()
        # Audio is already compressed – store, don't deflate.
        with zipfile.ZipFile(sink, "w", zipfile.ZIP_STORED, allowZip64=True) as zf:
            for rel in entries:
                full = os.path.join(DOWNLOADS_DIR, rel)
                try:
                    info = zipfile.ZipInfo.from_file(full, arcname=rel.replace(os.sep, "/"))
                    with open(full, "rb") as src, zf.open(info, "w", force_zip64=True) as dst:
                        while chunk := src.read(1 << 20):
                            dst.write(chunk)
                            yield sink.take()
                except OSError:
                    continue  # deleted since listing – skip it
                yield sink.take()
        yield sink.take()

    syslog_sender.send(f"files_zipped count={len(entries)}")
    name = f"bark-extractor-{datetime.now():%Y%m%d-%H%M%S}.zip"
    return Response(
        generate(),
        mimetype="application/zip",
        headers={"Content-Disposition": f'attachment; filename="{name}"'},
    )


@app.route("/api/files/<file_id>/stream")
def api_stream_file(file_id):
    """Serve audio inline for in-browser playback with range-request support for seeking."""
    path = _resolve_file_or_abort(file_id)
    return _send_audio(path, conditional=True)


@app.route("/api/files/<file_id>", methods=["DELETE"])
def api_delete_file(file_id):
    # Resolve name before deletion for the syslog message
    path = file_manager.get_file_path(file_id)
    fname = os.path.basename(path) if path else file_id
    if file_manager.delete_file(file_id):
        syslog_sender.send(f"file_deleted file={fname}")
        return jsonify({"ok": True})
    return jsonify({"ok": False, "error": "File not found"}), 404


# ---------------------------------------------------------------------------
# Routes – admin
# ---------------------------------------------------------------------------

_FFMPEG_VERSION: str | None = None
_manual_update = {"running": False, "result": None, "finished_at": None}


@app.route("/api/admin/status")
def api_admin_status():
    files = file_manager.list_files()
    try:
        disk = shutil.disk_usage(DOWNLOADS_DIR)
        disk_info = {"total": disk.total, "used": disk.used, "free": disk.free}
    except OSError:
        disk_info = None
    stamp = tool_manager.last_update_time()
    return jsonify({
        "app_version": APP_VERSION,
        "ytdlp_version": tool_manager.ytdlp_version(),
        "ytdlp_path": YTDLP_PATH,
        "ytdlp_last_update": datetime.fromtimestamp(stamp).isoformat(timespec="seconds") if stamp else None,
        "ytdlp_updating": tool_manager.is_updating(),
        "ytdlp_update": tool_manager.update_settings(),
        "manual_update": _manual_update,
        "deno_version": tool_manager.deno_version(),
        "ffmpeg_version": _FFMPEG_VERSION,
        "downloads_dir": DOWNLOADS_DIR,
        "library": {
            "files": len(files),
            "bytes": sum(f["size"] for f in files),
        },
        "disk": disk_info,
        "active_jobs": len(download_manager.get_active_jobs()),
        "events": list(reversed(_events))[:100],
    })


@app.route("/api/admin/update-ytdlp", methods=["POST"])
def api_admin_update_ytdlp():
    if tool_manager.is_updating() or _manual_update["running"]:
        return jsonify({"error": "An update is already running"}), 409

    def run():
        _manual_update.update(running=True, result=None, finished_at=None)
        try:
            ok = tool_manager.update_ytdlp(
                YTDLP_PATH, tool_manager.update_settings()["channel"], _tools_log)
            _manual_update["result"] = "ok" if ok else "failed"
        except Exception as e:
            _tools_log(f"Manual yt-dlp update error: {e}")
            _manual_update["result"] = "failed"
        finally:
            _manual_update.update(
                running=False, finished_at=datetime.now().isoformat(timespec="seconds"))

    _tools_log("Manual yt-dlp update requested from the admin panel")
    threading.Thread(target=run, daemon=True, name="ytdlp-manual-update").start()
    return jsonify({"ok": True})


# ---------------------------------------------------------------------------
# Background maintenance
# ---------------------------------------------------------------------------

def _job_janitor():
    """Periodically drop finished jobs from memory (they are kept for an hour
    so late page loads can still read their status, then released)."""
    while True:
        time.sleep(900)
        try:
            download_manager.cleanup_finished_jobs(max_age_seconds=3600)
        except Exception as exc:
            app.logger.warning("Job janitor error: %s", exc)


def _tools_log(msg: str):
    print(f"  [tools] {msg}", flush=True)
    lowered = msg.lower()
    level = "error" if any(w in lowered for w in ("fail", "error", "could not", "not found")) else "info"
    _record_event(level, f"tools: {msg}")
    syslog_sender.send(f"tools {msg}")


# Settings appended to .env on startup when absent, so they are discoverable
# and editable on the server without consulting .env.example. Existing keys,
# values, and comments are never modified.
_ENV_SEED_HEADER = "# yt-dlp auto-update settings (appended by the app; see .env.example for details)"
_ENV_SEED_DEFAULTS = {
    "YTDLP_AUTO_UPDATE": "true",
    "YTDLP_UPDATE_INTERVAL_DAYS": "3",
    "YTDLP_UPDATE_HOUR": "3",
    "YTDLP_UPDATE_CHANNEL": "nightly",
}


def _seed_env_defaults():
    env_path = BASE_DIR / ".env"
    try:
        lines = env_path.read_text().splitlines() if env_path.exists() else []
        existing = {
            line.strip().split("=", 1)[0].strip()
            for line in lines
            if line.strip() and not line.strip().startswith("#") and "=" in line
        }
        missing = [k for k in _ENV_SEED_DEFAULTS if k not in existing]
        if not missing:
            return
        block = [""] if lines else []
        if _ENV_SEED_HEADER not in lines:
            block.append(_ENV_SEED_HEADER)
        block += [f"{k}={_ENV_SEED_DEFAULTS[k]}" for k in missing]
        env_path.write_text("\n".join(lines + block) + "\n")
        print(f"  [tools] Added missing settings to .env: {', '.join(missing)}", flush=True)
    except OSError as exc:
        app.logger.warning("Could not seed .env defaults: %s", exc)


def _startup():
    """Check and prepare all runtime dependencies. Called on every start, so
    a plain `git pull && systemctl restart bark-extractor` picks everything up."""
    os.makedirs(DOWNLOADS_DIR, exist_ok=True)
    os.makedirs(SESSIONS_DIR, exist_ok=True)

    # FFmpeg presence check (warn only – the UI still serves the library)
    global _FFMPEG_VERSION
    if not (shutil.which(FFMPEG_PATH) or os.path.isfile(FFMPEG_PATH)):
        _tools_log(f"WARNING: ffmpeg not found at {FFMPEG_PATH!r} – "
                   "audio extraction will fail until it is installed")
    else:
        _FFMPEG_VERSION = tool_manager.probe_version([FFMPEG_PATH, "-version"])

    # Make the auto-update settings visible/editable in .env
    _seed_env_defaults()

    # yt-dlp + Deno: download when missing, keep yt-dlp updated overnight
    tool_manager.bootstrap(YTDLP_PATH, start_updater=True, log=_tools_log)

    threading.Thread(target=_job_janitor, daemon=True, name="job-janitor").start()


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    debug = os.getenv("FLASK_DEBUG", "false").lower() == "true"
    # Under the Flask debug reloader the script runs twice; only start the
    # background threads in the serving process.
    if not debug or os.environ.get("WERKZEUG_RUN_MAIN") == "true":
        _startup()
    print(f"  Bark Extractor v{APP_VERSION} starting on http://0.0.0.0:{PORT}")
    print(f"  Downloads directory: {DOWNLOADS_DIR}")
    app.run(host="0.0.0.0", port=PORT, debug=debug)
