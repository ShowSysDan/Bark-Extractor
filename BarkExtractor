# Recent notable events (tool updates, failed jobs) for the admin panel
_events: deque = deque(maxlen=200)


def _record_event(level: str, message: str):
    _events.append({
        "time": datetime.now().isoformat(timespec="seconds"),
        "level": level,
        "message": message,
    })


# Per-download SSE queues: download_id -> list of queue.Queue
_sse_subscribers: dict[str, list[queue.Queue]] = {}
_sse_lock = threading.Lock()


